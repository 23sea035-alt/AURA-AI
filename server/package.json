{
  "name": "@aura/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && node --env-file=.env --enable-source-maps ./dist/index.mjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "node --env-file=../.env --import ./node_modules/tsx/dist/esm/index.mjs src/eval/runner.ts",
    "eval:gen": "node --env-file=../.env --import ./node_modules/tsx/dist/esm/index.mjs src/eval/runner-generation.ts",
    "eval:consolidation": "node --env-file=../.env --import ./node_modules/tsx/dist/esm/index.mjs src/eval/runner-consolidation.ts",
    "build:eval": "esbuild src/eval/runner.ts --bundle --platform=node --format=esm --external:'../services/moderation/*' --external:'../db/src/*' --outfile=eval/runner.bundle.mjs"
  },
  "dependencies": {
    "@aura/shared": "workspace:*",
    "@clerk/backend": "^1.30.0",
    "@livekit/agents": "1.4.11",
    "@livekit/agents-plugin-cartesia": "1.4.11",
    "@livekit/agents-plugin-deepgram": "1.4.11",
    "@livekit/agents-plugin-silero": "1.4.11",
    "@livekit/rtc-node": "0.13.29",
    "@sentry/node": "^9.21.0",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "livekit-server-sdk": "^2.15.5",
    "openai": "^6.42.0",
    "p-queue": "^8.0.1",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "svix": "^1.60.0",
    "ws": "^8.17.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@livekit/protocol": "^1.48.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.4",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  },
  "peerDependencies": {
    "@livekit/protocol": "^1.48.0"
  }
}
