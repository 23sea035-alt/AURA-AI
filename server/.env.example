# ── Required ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aura:aura_secret@localhost:5432/aura_ai
PORT=8080

# ── Clerk Auth ───────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=pk_your-clerk-publishable-key
CLERK_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# ── AI / LLM ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
GROQ_API_KEY=gsk-your-groq-api-key

# Model selection (defaults shown — override per environment)
# MODEL_GENERATE_REPLY=llama-3.3-70b-versatile
# MODEL_MODERATE_INPUT=meta-llama/llama-prompt-guard-2-86m
# MODEL_MODERATE_OUTPUT=openai/gpt-oss-safeguard-20b
# MODEL_CONSOLIDATE_MEMORY=llama-3.1-8b-instant
# MODEL_FALLBACK_GENERATE_REPLY=llama-3.1-8b-instant
# MODEL_FALLBACK_MODERATE_INPUT=llama-3.3-70b-versatile
# MODEL_FALLBACK_MODERATE_OUTPUT=llama-3.3-70b-versatile
# MODEL_FALLBACK_CONSOLIDATE_MEMORY=llama-3.3-70b-versatile

# ── Payments (RevenueCat) ─────────────────────────────────────────────
REVENUECAT_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# ── APNs ──────────────────────────────────────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_FILE=
APNS_ENVIRONMENT=sandbox

# ── Voice (Inworld TTS 2 + Groq STT over WebSocket) ──────────────────
# All optional — voice routes degrade gracefully when unset.
# INWORLD_API_KEY: paste the Base64 "Basic" key from the Inworld portal as-is.
# Voice IDs: stock voices use the voice NAME as the id (e.g. Deborah). Cast list +
# per-persona delivery tuning: docs/specs/voice-casting-guide.md.
INWORLD_API_KEY=
INWORLD_VOICE_ID_AURORA=Deborah
INWORLD_VOICE_ID_ORION=Edward
INWORLD_VOICE_ID_LYRA=Sarah
# Gallery (9) — cast 2026-07-10 (auditioned on CREATIVE per the naturalness probe).
INWORLD_VOICE_ID_SAGE=Tunde
INWORLD_VOICE_ID_AMARA=Saanvi
INWORLD_VOICE_ID_ELI=Miguel
INWORLD_VOICE_ID_SELENE=Wendy
INWORLD_VOICE_ID_SOREN=Lucian
INWORLD_VOICE_ID_JUNO=Asuka
# Thea: recast off Svetlana (Russian accent leaked through). If "Folake" is a COMMUNITY voice it needs
# the community-* id, not the name (see Cyrus) — the audition run will 404 if so.
INWORLD_VOICE_ID_THEA=Folake
# Cyrus: "Thomas" is a COMMUNITY voice — id is the community-* slug, NOT the display name
# (stock voices use the name; community voices use the id). Hindi accent-steer (PERSONA_LOCALE=hi-IN)
# + BALANCED — see voice-tuning.ts.
INWORLD_VOICE_ID_CYRUS=community-snyihdsosxjx
# Wren: recast off Galina → Yoona, English forced (PERSONA_LOCALE=en-US). If "Yoona" is a community
# voice it needs the community-* id, not the name.
INWORLD_VOICE_ID_WREN=Yoona

# ── Security ──────────────────────────────────────────────────────────
BANNED_IDENTITY_PEPPER=generate-a-strong-random-pepper-here

# ── Monitoring ────────────────────────────────────────────────────────
SENTRY_DSN=
