# Client env (EXPO_PUBLIC_* is inlined at bundle time — restart Metro after
# changing anything here; a fast-refresh reload is NOT enough).

# ── Mock/live switch ─────────────────────────────────────────────────
# Dev default is mocks ON (fully local app, no backend needed). Set to
# "false" to run against the real backend. Release builds are always
# live regardless (constants/devFlags.ts gates on __DEV__).
EXPO_PUBLIC_USE_MOCKS=true

# ── Live mode config ─────────────────────────────────────────────────
# REST base. When unset, falls back to http://localhost:8080/api (iOS sim)
# or http://10.0.2.2:8080/api (Android emulator) — see client/lib/env.ts.
EXPO_PUBLIC_API_URL=

# Clerk publishable key (dashboard → API keys). pk_test_… for dev.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# RevenueCat public SDK key. Test Store key while we're pre-App Store;
# products: aura_premium_monthly / aura_premium_yearly.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# ── Legacy (Replit shared dev domain; superseded by EXPO_PUBLIC_API_URL) ──
EXPO_PUBLIC_DOMAIN=
